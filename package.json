{
  "name": "focus-companion",
  "version": "1.0.0",
  "description": "A floating desktop companion that reflects how on-task you are.",
  "main": "main.js",
  "scripts": {
    "start": "concurrently --kill-others-on-fail \"npm run dev\" \"wait-on tcp:5173 && set VITE_DEV_SERVER_URL=http://127.0.0.1:5173&& electron .\"",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "setup:electron": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ node node_modules/electron/install.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.63.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.0",
    "concurrently": "^9.2.4",
    "electron": "^32.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^5.3.4",
    "wait-on": "^8.0.5"
  },
  "allowScripts": {
    "electron@32.0.0": true,
    "esbuild@0.21.5": true
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node"
  }
}
